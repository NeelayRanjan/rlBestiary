(
    world: (
        // Square terrain cell count along each axis.
        grid: 32,
        // Width of one terrain cell in metres.
        cell_metres: 32.0,
        // Ten fixed ticks per simulated hour.
        seconds_per_tick: 360.0,
        // Recurrent decisions are refreshed on deterministic staggered ticks.
        decision_interval: 10,
        // One seasonal cycle in world ticks.
        season_ticks: 3600,
        // Plant reproduction/selection interval.
        plant_epoch: 100,
        // Maximum energy supplied by sunlight per cell/tick, in millijoules.
        solar_per_cell: 10000000,
        // Soil nutrient inventory per cell, in microkilograms.
        soil_per_cell: 2000000,
        // Initial plant energy and nutrient inventories per cell.
        plant_energy: 2000000000,
        plant_nutrients: 2000000,
        // Initial individual energy reserve, in millijoules.
        initial_energy: 200000000,
        // Maximum energy reserve per kilogram of grown body mass.
        reserve_per_kg: 500000000,
        // Maximum energy removed in one foraging action.
        bite_energy: 50000000,
        // Basal metabolic watts per kilogram, additional to measured posture.
        basal_per_kg: 0.2,
        // Additional watts per sensor and neuron.
        sensor_cost: 0.002,
        brain_cost: 0.001,
        // Maximum fraction of adult mass grown per tick.
        growth_per_tick: 0.005,
        // Fraction of carcass resources returned to soil/heat each tick.
        decay_fraction: 0.01,
        // Health loss per fully unpaid metabolic tick and recovery per fed tick.
        starvation_damage: 0.02,
        healing: 0.01,
        // Terrain threshold separating land from water.
        water_level: -0.4,
        // Seasonal variation in temperature and solar availability.
        season_amplitude: 0.3,
        // Explicit finite carrying bound; births beyond it are not admitted.
        population_limit: 10000,
        // Fixed integer resource resolution.
        energy_units_per_joule: 1000.0,
        nutrient_units_per_kg: 1000000.0,
    ),
    combine: (
        // Duration of each deterministic physical trial in seconds.
        trial_seconds: 2.0,
        // Root must clear terrain for at least two seconds.
        stand_seconds: 2.0,
        // Minimum root center height above terrain in metres.
        root_clearance: 0.05,
        // Height of deterministic rough-ground bumps.
        rough_height: 0.03,
        // Sampled slope angles in radians, in increasing order.
        slope_angles: [0.1, 0.2, 0.35],
        // Fluid density in the simulator's SI mass convention.
        water_density: 2.0,
        // Linear fluid drag coefficient per immersed volume.
        water_drag: 4.0,
        // Added carry load as a fraction of body mass.
        carry_fraction: 0.5,
    ),
    genome: (
        // Absolute bound on expanded rigid parts.
        max_parts: 32,
        // Maximum edge depth of an expanded body.
        max_depth: 12,
        // Maximum expanded mass in kilograms.
        max_mass: 100.0,
        // Minimum full part dimension in metres.
        min_size: 0.02,
        // Maximum joints crossed by a muscle.
        max_span: 2,
        // Bounds on heritable per-copy mutation probabilities.
        mutation_floor: 0.001,
        mutation_ceiling: 0.5,
        // Genesis attachment offset in normalized surface coordinates.
        attachment_jitter: 0.2,
    ),
    physics: (
        // Gravitational acceleration, metres per second squared.
        gravity: 9.81,
        // Substeps within each fixed 1/240-second physics tick.
        substeps: 2,
        // Coulomb ground friction coefficient.
        friction: 0.9,
        // Maximum force per unit muscle cross-sectional area.
        force_per_area: 120.0,
        // Relative width of the parabolic length-tension curve.
        length_tension_width: 0.8,
        // Minimum active length is rest length times (1 - fraction).
        max_contraction_fraction: 0.55,
        // Passive stretch-only spring stiffness (newtons/metre).
        passive_stiffness: 20.0,
        // Passive axial damping coefficient.
        damping: 0.5,
        // Holding energy per area, activation and simulated second.
        isometric_cost: 0.05,
        // Absolute numerical energy allowance per substep, joules.
        audit_absolute_tolerance: 0.01,
        // Relative numerical energy allowance per substep.
        audit_relative_tolerance: 0.005,
        // M1 fixture's controller frequency in hertz.
        fixture_frequency: 1.5,
        // M1 fixture's muscle cross-sectional area.
        fixture_muscle_area: 0.1,
        // Seconds simulated per trial in the M1 nine-workload gate.
        benchmark_trial_seconds: 2.0,
    ),
)
